# .env.template — AREUM 인스턴스용 환경변수 템플릿
# 복제 후 ".env" 로 이름을 바꾸고 아래 값들을 채워주세요.

# ─── 제국 코어망 접속 (EDENVALE 기본) ──────────────────────────────────────────
CORE_HOST=127.0.0.1
PORT_CORE_API=8800

# ─── 보안 토큰 (EDENVALE/.env 의 GATEWAY_TOKEN 과 동일하게 설정) ───────────────
GATEWAY_TOKEN=YOUR_GATEWAY_TOKEN_HERE

# ─── 소속 영토 및 계층 정보 (STRATUM 생성 후 spawn_areum.py 가 자동 주입) ────────
STRATUM_ID=UNKNOWN_STRATUM
QUEEN_ID=UNKNOWN_QUEEN
AREUM_NAME=AREUM-1

# ─── 로컬 Ollama 설정 ──────────────────────────────────────────────────────────
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma3:4b
