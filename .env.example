# ============================================
# Monewment Platform Environment Variables
# ============================================

# Application Settings
PROJECT_NAME=Monewment
DEBUG=false
LOG_LEVEL=INFO

# CORS Settings (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security Keys (Generate with: python scripts/generate_keys.py)
SECRET_KEY=your-secret-key-at-least-32-characters-long-replace-this
ANT_ENCRYPTION_KEY=your-64-character-hex-encryption-key-replace-this

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=user
POSTGRES_PASSWORD=your-strong-password-replace-this
POSTGRES_DB=monewment
POSTGRES_PORT=5433

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AI API Keys
GEMINI_API_KEY=your-gemini-api-key
CLAUDE_API_KEY=your-claude-api-key-optional

# Blender Path (for DeepRender)
BLENDER_PATH=C:\\Program Files\\Blender Foundation\\Blender 5.0\\blender.exe

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
